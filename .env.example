# PostgreSQL (Railway provides DATABASE_URL when you add Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/team_tasks?schema=public"

# Required in production — use a long random string
JWT_SECRET="change-me-in-production"

# Optional: comma-separated origins for CORS (leave unset for same-origin)
# CLIENT_ORIGIN="https://your-app.up.railway.app"

# Server port (Railway sets PORT automatically)
PORT=4000
